# Copy to .env before `docker compose up`. Only APP_AUTH_TOKEN is required.

# Shared secret for the login screen. Generate one with: openssl rand -hex 32
APP_AUTH_TOKEN=

# Address browsers use to reach the stack.
#   https://<hostname-or-lan-ip>  TLS from Caddy's internal CA (trust its root cert on clients)
#   http://<hostname-or-lan-ip>   plain HTTP; also set AUTH_COOKIE_SECURE=0
SITE_ADDRESS=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
AUTH_COOKIE_SECURE=1

# LLM defaults. Optional; App Settings in the UI can set and change all of these.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
# A model server running on the Docker host itself: http://host.docker.internal:8080/v1
LLM_BASE_URL=
DEFAULT_MODEL=
LLM_REASONING_EFFORT=

# Optional connector key for the Marketplace.
COMPOSIO_API_KEY=

# Host directory mounted as the bots' /workspace for the approved workspace tools.
WORKSPACE_DIR=./workspace
