<?xml version="1.0" encoding="UTF-8"?>
<!-- Window manager settings for the sandbox desktop. There is no task list,
     so a minimized window would have nothing to bring it back; windows get
     maximize and close buttons only (no window menu, which also has Hide). -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="button_layout" type="string" value="|MC"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="theme" type="string" value="Default"/>
    <property name="title_font" type="string" value="DejaVu Sans Bold 9"/>
    <property name="workspace_count" type="int" value="1"/>
    <property name="click_to_focus" type="bool" value="true"/>
    <property name="focus_new" type="bool" value="true"/>
    <property name="raise_on_click" type="bool" value="true"/>
    <property name="placement_mode" type="string" value="center"/>
    <property name="placement_ratio" type="int" value="20"/>
  </property>
</channel>
